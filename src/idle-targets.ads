package Idle.Targets is

   --  The code generators. Each child package generates the Ada packages
   --  for one target from the syntax tree.

   type Target is
     (Kernel_Target, User_Target, Host_Target);
   --  Kernel_Target : "kernel", the subset of Ada available to Rose's
   --                  kernel-level code, with no tagged types or
   --                  interfaces (Idle.Targets.Kernel).
   --  User_Target   : "user", for programs built with Rose's userland
   --                  run-time system: an interface is an Ada interface
   --                  type, with a client type and a server interface
   --                  that implement it. The packages have the same
   --                  names and encoding as the kernel target's, and are
   --                  generated by the same code (Idle.Targets.Kernel).
   --  Host_Target   : "host", for a command built for the host's own Ada
   --                  run-time, to test it without Rose (idle#133, Rose
   --                  #1101): an interface has the user target's package
   --                  with its object type, and no client or server, and
   --                  a command's main binds the process's command line
   --                  to its arguments, and opens the host backing of
   --                  each interface (Idle.Host_Backings).

   Default_Target : constant Target := Kernel_Target;

   function Name (Item : Target) return String;
   --  The target's name on the command line: "kernel", "user" or "host".

   function Has_Objects (Item : Target) return Boolean
   is (Item in User_Target | Host_Target);
   --  True if an interface's package declares its object type, an Ada
   --  interface, which a command takes its interface arguments as.

   function Find (Text : String; Item : out Target) return Boolean;
   --  Set Item to the target named Text, ignoring case. False if there
   --  is none.

   function Names return String;
   --  The names of every target, separated by ", ", for messages.

end Idle.Targets;
