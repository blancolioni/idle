with "config/idle_config.gpr";

project Idle is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Idle_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("idle-main.adb");

   package Builder is
      for Executable ("idle-main.adb") use "idle";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use Idle_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Idle;
