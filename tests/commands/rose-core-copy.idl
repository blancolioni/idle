--  Interface arguments, out arguments, and roles whose members are not
--  standard streams (idle#27). Target and Root are versioned, since the
--  command is not live, and Copied is a writable cap the command returns
--  (Rose ADR 0012).

command Rose.Core.Copy : Standard_Error, Logging, Create_Endpoint, Delete_Cap
  with Summary => "Copy a file."
is
   Source : in File
     with Help => "the file to copy";
   Target : in Writable_File
     with Help => "the new file";
   Root : in Writable_Directory
     with Help => "where the new file goes";
   Copied : out Writable_File
     with Help => "the copy";
   Count : out Natural
     with Help => "the number of bytes copied";
   Verbose : Boolean := False
     with Short_Name => 'v',
          Help       => "report progress";
   Report : out String
     with Help => "a summary of the copy";
   Note : String := "none"
     with Help => "a note";
end Rose.Core.Copy;
