interface Named is

   Max_Badges : constant := 16;

   type Badge_Count is range 0 .. Max_Badges;
   type Badge_Serial is new Word_64;
   type Badge_Colour is (Red, Green, Blue);

   --  Pinned, so the generated package shows the pinned id.
   function Badge return Capability
     with Endpoint_Id => 16#BAD6_E000_0000_0001#;

end Named;
