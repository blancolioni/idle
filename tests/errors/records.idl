--  Record syntax that is wrong (idle#113): aspects, which wait for
--  versions (idle#114), a record with no fields, and a record that isn't
--  closed with "end record".

interface Records is

   type Versioned is record
      Name : String;
   end record with Version => 2;

   type Empty is record
   end record;

   type Unclosed is record
      Size : Natural;
   end Unclosed;

   procedure Reset;

end Records;
