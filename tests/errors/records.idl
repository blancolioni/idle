--  Record syntax that is wrong (idle#113): an aspect other than Version,
--  a record with no fields, and a record that isn't
--  closed with "end record".

interface Records is

   type Versioned is record
      Name : String;
   end record with Colour => Blue;

   type Empty is record
   end record;

   type Unclosed is record
      Size : Natural;
   end Unclosed;

   procedure Reset;

end Records;
